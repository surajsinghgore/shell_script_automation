# =============================================================================
#  Deploy on push — copy this into YOUR APP's repo as .github/workflows/deploy.yml
#
#  It does not live in this repo's workflows: it belongs beside the code it
#  deploys, so a push to that repo triggers it.
#
#  Required repository secrets (Settings -> Secrets and variables -> Actions):
#    VPS_HOST      54.89.160.254
#    VPS_USER      ubuntu
#    VPS_SSH_KEY   the FULL contents of your .pem, including the BEGIN/END lines
#
#  Required repository variables (same page, "Variables" tab):
#    APP_DIR       /home/ubuntu/apps/<site>      the checkout on the server
#    WEB_ROOT      /var/www/<site>               releases + current symlink
#    PM2_NAME      <site>                        omit entirely for a static site
#    BUILD_CMD     npm run build                 omit if there is no build
#
#  Read CI.md before enabling this. It hands a key with sudo access to GitHub,
#  which is a real trade-off and not always the right one.
# =============================================================================

name: Deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

# Never let two deploys of the same branch overlap — they would fight over the
# same checkout on the server.
concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Load the SSH key
        run: |
          mkdir -p ~/.ssh
          printf '%s\n' "${{ secrets.VPS_SSH_KEY }}" > ~/.ssh/deploy.pem
          chmod 600 ~/.ssh/deploy.pem
          # Pin the host key instead of disabling checking, so a swapped server
          # fails loudly rather than silently accepting a new fingerprint.
          ssh-keyscan -H "${{ secrets.VPS_HOST }}" >> ~/.ssh/known_hosts 2>/dev/null

      - name: Deploy
        env:
          HOST:      ${{ secrets.VPS_HOST }}
          USER:      ${{ secrets.VPS_USER }}
          APP_DIR:   ${{ vars.APP_DIR }}
          WEB_ROOT:  ${{ vars.WEB_ROOT }}
          PM2_NAME:  ${{ vars.PM2_NAME }}
          BUILD_CMD: ${{ vars.BUILD_CMD }}
          BRANCH:    ${{ github.ref_name }}
          SHA:       ${{ github.sha }}
        run: |
          ssh -i ~/.ssh/deploy.pem -o ConnectTimeout=20 "$USER@$HOST" \
            "APP_DIR='$APP_DIR' WEB_ROOT='$WEB_ROOT' PM2_NAME='$PM2_NAME' \
             BUILD_CMD='$BUILD_CMD' BRANCH='$BRANCH' bash -s" <<'REMOTE'
          set -euo pipefail

          # Refuse rather than fill the disk — the same guard the local scripts use.
          FREE_MB=$(df -Pm / | awk 'NR==2{print $4}')
          [ "$FREE_MB" -ge 300 ] || { echo "ERROR: only ${FREE_MB}MB free"; exit 1; }

          cd "$APP_DIR"
          # The .env on the server was uploaded by ./edit-env.sh and is NOT in
          # git. `git reset --hard` would revert a tracked .env, so save it.
          ENV_BAK=""
          [ -f .env ] && { ENV_BAK="$(mktemp)"; cp .env "$ENV_BAK"; }

          git fetch --all --prune
          git checkout -f "$BRANCH"
          git reset --hard "origin/$BRANCH"

          if [ -n "$ENV_BAK" ]; then
            cmp -s "$ENV_BAK" .env 2>/dev/null || { cp "$ENV_BAK" .env; echo "--- restored .env"; }
            chmod 600 .env; rm -f "$ENV_BAK"
          fi

          echo "--- $(git log -1 --pretty='%h %s')"
          npm ci

          if [ -n "${BUILD_CMD:-}" ]; then
            NODE_ENV=production eval "$BUILD_CMD"
          fi

          REL="$(date -u +%Y%m%d-%H%M%S)-$(git rev-parse --short HEAD)"
          NEW="$WEB_ROOT/releases/$REL"
          mkdir -p "$NEW"

          if [ -n "${PM2_NAME:-}" ]; then
            # Server app: the whole prepared tree becomes the release.
            tar -C "$APP_DIR" --exclude=./.git -cf - . | tar -C "$NEW" -xf -
          else
            # Static site: only the build output.
            SRC=""
            for d in dist build out; do [ -d "$APP_DIR/$d" ] && { SRC="$APP_DIR/$d"; break; }; done
            [ -n "$SRC" ] || { echo "ERROR: no build output"; rm -rf "$NEW"; exit 1; }
            [ -f "$SRC/index.html" ] || { echo "ERROR: no index.html"; rm -rf "$NEW"; exit 1; }
            sudo cp -a "$SRC/." "$NEW/"
            sudo chown -R www-data:www-data "$NEW"
          fi

          # Atomic: build a new symlink, then rename it over the old one.
          ln -sfn "$NEW" "$WEB_ROOT/.current.tmp"
          mv -Tf "$WEB_ROOT/.current.tmp" "$WEB_ROOT/current"
          echo "--- live: $REL"

          if [ -n "${PM2_NAME:-}" ]; then
            pm2 restart "$PM2_NAME" --update-env
            pm2 save >/dev/null
            for i in $(seq 1 20); do
              curl -fsS -o /dev/null --max-time 3 "http://127.0.0.1:$(pm2 jlist \
                | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
                    const a=JSON.parse(s).find(p=>p.name===process.env.PM2_NAME)||{};
                    console.log((a.pm2_env||{}).PORT||3000)})')/" && { echo "responded OK"; break; }
              [ "$i" = "20" ] && echo "WARNING: no response — check pm2 logs $PM2_NAME"
              sleep 2
            done
          fi

          # Keep the newest 3, never the live one.
          CUR="$(readlink -f "$WEB_ROOT/current")"
          cd "$WEB_ROOT/releases"
          ls -1d */ 2>/dev/null | sort -r | tail -n +4 | while read -r old; do
            old="${old%/}"
            [ "$(readlink -f "$old")" = "$CUR" ] && continue
            sudo rm -rf "$WEB_ROOT/releases/$old"
          done
          exit 0
          REMOTE

      - name: Clean up the key
        if: always()
        run: rm -f ~/.ssh/deploy.pem
